<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>aaxely — URL Shortener</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Circular+Std:wght@400;700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='12' fill='%231DB954'/%3E%3Cg transform='translate(3.5 3.5) scale(0.71)'%3E%3Cpath fill='%23000' d='M10 9L15 12L10 15V9ZM4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z'/%3E%3C/g%3E%3C/svg%3E">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-base: #0a0a0a;
            --bg-elevated: #121212;
            --bg-card: #181818;
            --bg-highlight: #282828;
            --bg-hover: #2a2a2a;
            --green: #1DB954;
            --green-dim: #158a3e;
            --green-glow: rgba(29, 185, 84, 0.15);
            --green-glow-strong: rgba(29, 185, 84, 0.3);
            --red: #ff4d4d;
            --red-glow: rgba(255, 77, 77, 0.15);
            --white: #FFFFFF;
            --white-70: rgba(255,255,255,0.7);
            --white-40: rgba(255,255,255,0.4);
            --white-15: rgba(255,255,255,0.08);
            --font-display: 'DM Sans', sans-serif;
            --font-mono: 'Space Mono', monospace;
            --radius-sm: 6px;
            --radius-md: 12px;
            --radius-lg: 20px;
            --radius-pill: 500px;
            --transition: 0.2s cubic-bezier(0.3, 0, 0, 1);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-base);
            color: var(--white);
            font-family: var(--font-display);
            min-height: 100vh;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Noise overlay ── */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
            background-size: 200px;
            pointer-events: none;
            z-index: 0;
            opacity: 0.5;
        }

        /* ── Radial accent glow ── */
        body::after {
            content: '';
            position: fixed;
            top: -20vh;
            left: 50%;
            transform: translateX(-50%);
            width: 80vw;
            max-width: 900px;
            height: 60vh;
            background: radial-gradient(ellipse at center, rgba(29,185,84,0.07) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        /* ── Layout ── */
        .page-wrapper {
            position: relative;
            z-index: 1;
            max-width: 860px;
            margin: 0 auto;
            padding: 0 20px 80px;
        }

        /* ── Nav ── */
        nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 28px 0 0;
            gap: 12px;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: var(--green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .logo-icon svg {
            width: 18px;
            height: 18px;
            fill: #000;
        }

        .logo-text {
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            color: var(--white);
        }

        .nav-badge {
            background: var(--white-15);
            border: 1px solid rgba(255,255,255,0.1);
            color: var(--white-70);
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: var(--radius-pill);
        }

        .logout-btn {
            background: transparent;
            border: 1px solid rgba(255,255,255,0.15);
            color: var(--white-70);
            font-family: var(--font-display);
            font-size: 0.8rem;
            font-weight: 500;
            padding: 7px 16px;
            border-radius: var(--radius-pill);
            cursor: pointer;
            transition: all var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }

        .logout-btn:hover {
            background: var(--red-glow);
            border-color: rgba(255,77,77,0.4);
            color: var(--red);
        }

        .logout-btn svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ── Hero ── */
        .hero {
            text-align: center;
            padding: 72px 0 56px;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--green-glow);
            border: 1px solid rgba(29,185,84,0.25);
            color: var(--green);
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 6px 14px;
            border-radius: var(--radius-pill);
            margin-bottom: 28px;
        }

        .hero-tag::before {
            content: '';
            width: 7px;
            height: 7px;
            background: var(--green);
            border-radius: 50%;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(0.8); }
        }

        .hero h1 {
            font-size: clamp(2.6rem, 7vw, 4.8rem);
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1.05;
            margin-bottom: 20px;
        }

        .hero h1 em {
            font-style: normal;
            color: var(--green);
        }

        .hero p {
            font-size: clamp(1rem, 2.5vw, 1.15rem);
            color: var(--white-70);
            font-weight: 300;
            line-height: 1.65;
            max-width: 500px;
            margin: 0 auto;
        }

        /* ── Result Banner ── */
        .result-banner {
            background: linear-gradient(135deg, rgba(29,185,84,0.12) 0%, rgba(29,185,84,0.04) 100%);
            border: 1px solid rgba(29,185,84,0.3);
            border-radius: var(--radius-lg);
            padding: 20px 24px;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            gap: 16px;
            animation: slideDown 0.4s cubic-bezier(0.3, 0, 0, 1);
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-12px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .result-banner-icon {
            width: 40px;
            height: 40px;
            background: var(--green);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .result-banner-icon svg {
            width: 20px;
            height: 20px;
            fill: #000;
        }

        .result-banner-content {
            flex: 1;
            min-width: 0;
        }

        .result-banner-label {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--green);
            margin-bottom: 5px;
        }

        .result-banner-link {
            font-family: var(--font-mono);
            font-size: 0.9rem;
            color: var(--white);
            text-decoration: none;
            word-break: break-all;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            padding-bottom: 1px;
            transition: color var(--transition), border-color var(--transition);
        }

        .result-banner-link:hover {
            color: var(--green);
            border-color: var(--green);
        }

        .copy-btn {
            background: var(--bg-highlight);
            border: 1px solid rgba(255,255,255,0.1);
            color: var(--white-70);
            font-family: var(--font-display);
            font-size: 0.8rem;
            font-weight: 500;
            padding: 8px 14px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all var(--transition);
            white-space: nowrap;
            flex-shrink: 0;
        }

        .copy-btn:hover {
            background: var(--bg-hover);
            color: var(--white);
            border-color: rgba(255,255,255,0.2);
        }

        .copy-btn.copied {
            background: var(--green-glow);
            color: var(--green);
            border-color: rgba(29,185,84,0.4);
        }

        /* ── Form card ── */
        .form-card {
            background: var(--bg-card);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: var(--radius-lg);
            padding: 32px;
            margin-bottom: 56px;
            box-shadow: 0 24px 48px rgba(0,0,0,0.4);
        }

        .form-card-title {
            font-size: 1.05rem;
            font-weight: 600;
            margin-bottom: 20px;
            color: var(--white);
        }

        .input-row {
            display: flex;
            gap: 12px;
        }

        .url-input {
            flex: 1;
            background: var(--bg-highlight);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: var(--radius-md);
            color: var(--white);
            font-family: var(--font-mono);
            font-size: 0.88rem;
            padding: 14px 18px;
            outline: none;
            transition: border-color var(--transition), box-shadow var(--transition);
            min-width: 0;
        }

        .url-input::placeholder {
            color: var(--white-40);
        }

        .url-input:focus {
            border-color: var(--green);
            box-shadow: 0 0 0 3px var(--green-glow-strong);
        }

        .submit-btn {
            background: var(--green);
            color: #000;
            border: none;
            border-radius: var(--radius-md);
            font-family: var(--font-display);
            font-size: 0.95rem;
            font-weight: 700;
            padding: 14px 28px;
            cursor: pointer;
            white-space: nowrap;
            transition: transform var(--transition), background var(--transition), box-shadow var(--transition);
            letter-spacing: -0.01em;
        }

        .submit-btn:hover {
            background: #22d860;
            transform: scale(1.03);
            box-shadow: 0 4px 20px var(--green-glow-strong);
        }

        .submit-btn:active {
            transform: scale(0.98);
        }

        /* ── Features ── */
        .section-label {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--white-40);
            margin-bottom: 24px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 64px;
        }

        .feature-card {
            background: var(--bg-card);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: var(--radius-md);
            padding: 24px;
            transition: background var(--transition), border-color var(--transition), transform var(--transition);
        }

        .feature-card:hover {
            background: var(--bg-highlight);
            border-color: rgba(255,255,255,0.12);
            transform: translateY(-3px);
        }

        .feature-icon {
            width: 42px;
            height: 42px;
            background: var(--green-glow);
            border: 1px solid rgba(29,185,84,0.2);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
        }

        .feature-icon svg {
            width: 20px;
            height: 20px;
            stroke: var(--green);
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .feature-card h3 {
            font-size: 0.95rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .feature-card p {
            font-size: 0.83rem;
            color: var(--white-40);
            line-height: 1.6;
            font-weight: 300;
        }

        /* ── How to use ── */
        .how-section {
            margin-bottom: 64px;
            scroll-margin-top: 24px;
        }

        .steps-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .step {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            padding: 20px 24px;
            background: var(--bg-card);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: var(--radius-md);
            transition: background var(--transition);
            position: relative;
        }

        .step:hover { background: var(--bg-highlight); }

        .step-num {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--green);
            background: var(--green-glow);
            border: 1px solid rgba(29,185,84,0.2);
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .step-content h4 {
            font-size: 0.95rem;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .step-content p {
            font-size: 0.83rem;
            color: var(--white-40);
            line-height: 1.6;
            font-weight: 300;
        }

        /* ── Links list ── */
        .links-section {
            margin-bottom: 64px;
        }

        .links-section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .links-count {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--white-40);
            background: var(--white-15);
            padding: 3px 10px;
            border-radius: var(--radius-pill);
        }

        .links-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .link-item {
            background: var(--bg-card);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: var(--radius-md);
            padding: 18px 22px;
            display: grid;
            grid-template-columns: 1fr auto auto;
            gap: 12px 20px;
            align-items: center;
            transition: background var(--transition), border-color var(--transition);
        }

        .link-item:hover {
            background: var(--bg-highlight);
            border-color: rgba(255,255,255,0.1);
        }

        .link-original {
            font-size: 0.82rem;
            color: var(--white-40);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 300;
            grid-column: 1 / -1;
        }

        .link-short {
            font-family: var(--font-mono);
            font-size: 0.88rem;
            color: var(--green);
            text-decoration: none;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: opacity var(--transition);
        }

        .link-short:hover { opacity: 0.75; }

        .link-clicks {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.78rem;
            color: var(--white-40);
            white-space: nowrap;
            flex-shrink: 0;
        }

        .link-clicks svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
        }

        .delete-btn {
            background: transparent;
            border: 1px solid rgba(255,77,77,0.25);
            color: var(--red);
            border-radius: var(--radius-sm);
            padding: 6px 8px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all var(--transition);
            flex-shrink: 0;
        }

        .delete-btn:hover {
            background: var(--red-glow);
            border-color: rgba(255,77,77,0.5);
        }

        .delete-btn svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ── Empty state ── */
        .empty-state {
            text-align: center;
            padding: 56px 24px;
            background: var(--bg-card);
            border: 1px dashed rgba(255,255,255,0.1);
            border-radius: var(--radius-lg);
        }

        .empty-state-icon {
            width: 56px;
            height: 56px;
            background: var(--white-15);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
        }

        .empty-state-icon svg {
            width: 26px;
            height: 26px;
            stroke: var(--white-40);
            fill: none;
            stroke-width: 1.5;
        }

        #logoutText{
            color: white;
            text-decoration: none;
        }

        .empty-state p {
            font-size: 0.95rem;
            color: var(--white-40);
            font-weight: 300;
        }

        .empty-state strong {
            display: block;
            font-size: 1rem;
            color: var(--white-70);
            font-weight: 600;
            margin-bottom: 6px;
        }

        /* ── Footer ── */
        footer {
            border-top: 1px solid rgba(255,255,255,0.07);
            padding-top: 40px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            align-items: start;
        }

        .footer-brand .logo-text {
            font-size: 1.1rem;
            display: block;
            margin-bottom: 10px;
        }

        .footer-brand p {
            font-size: 0.82rem;
            color: var(--white-40);
            font-weight: 300;
            line-height: 1.6;
            max-width: 260px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
        }

        .footer-links a {
            font-size: 0.82rem;
            color: var(--white-40);
            text-decoration: none;
            transition: color var(--transition);
            font-weight: 400;
        }

        .footer-links a:hover { color: var(--white); }

        .footer-bottom {
            grid-column: 1 / -1;
            padding-top: 24px;
            border-top: 1px solid rgba(255,255,255,0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

        .footer-bottom p {
            font-size: 0.75rem;
            color: var(--white-40);
            font-weight: 300;
        }

        .footer-bottom span {
            color: var(--green);
        }

        /* ── Divider ── */
        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
            margin: 56px 0;
        }

        /* ── Responsive ── */
        @media (max-width: 600px) {
            nav { padding-top: 20px; }
            .hero { padding: 48px 0 40px; }
            .form-card { padding: 22px 18px; }
            .input-row { flex-direction: column; }
            .submit-btn { width: 100%; text-align: center; }
            .result-banner { flex-wrap: wrap; }
            .copy-btn { width: 100%; text-align: center; }
            footer { grid-template-columns: 1fr; }
            .footer-links { align-items: flex-start; }
            .footer-bottom { flex-direction: column; align-items: flex-start; }
            .link-item { grid-template-columns: 1fr auto; }
        }

        @media (max-width: 400px) {
            .hero h1 { font-size: 2.2rem; }
            .features-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<div class="page-wrapper">

    <!-- ── Navigation ── -->
    <nav>
        <a href="/" class="logo">
            <div class="logo-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 9L15 12L10 15V9ZM4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z"/>
                </svg>
            </div>
            <span class="logo-text">aaxely</span>
        </a>
        <div class="nav-right">
            <span class="nav-badge">Free &amp; Fast</span>
            <button class="logout-btn" id="logoutBtn" type="button">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <a id="logoutText" href="/users/logout">Logout</a>
            </button>
        </div>
    </nav>

    <!-- ── Hero ── -->
    <section class="hero">
        <div class="hero-tag">Now live</div>
        <h1>Shorten. Share.<br><em>Track.</em></h1>
        <p>Transform long, messy URLs into clean, shareable links in a single click — with built-in click analytics.</p>
    </section>

    <!-- ── Result Banner (shown after shortening) ── -->
    <% if (locals.id) { %>
    <div class="result-banner">
        <div class="result-banner-icon">
            <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
        </div>
        <div class="result-banner-content">
            <div class="result-banner-label">Your link is ready</div>
            <a class="result-banner-link" href="http://localhost:8000/url/<%= locals.id %>">http://localhost:8000/url/<%= locals.id %></a>
        </div>
        <button class="copy-btn" onclick="copyLink(this, 'http://localhost:8000/url/<%= locals.id %>')">Copy</button>
    </div>
    <% } %>

    <!-- ── Form Card ── -->
    <div class="form-card">
        <div class="form-card-title">Paste your long URL below</div>
        <form method="post" action="/url">
            <div class="input-row">
                <input
                    class="url-input"
                    type="text"
                    name="originalUrl"
                    placeholder="https://your-very-long-link.com/path/to/page?utm=..."
                    autocomplete="off"
                    spellcheck="false"
                >
                <button class="submit-btn" type="submit">Shorten →</button>
            </div>
        </form>
    </div>

    <!-- ── Features Section ── -->
    <section id="features" style="scroll-margin-top: 24px;">
        <div class="section-label">Why aaxely</div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                </div>
                <h3>Lightning Fast</h3>
                <p>Redirects happen in milliseconds. No loading screens, no friction — just instant delivery.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                </div>
                <h3>Click Analytics</h3>
                <p>Every link tracks total visits automatically. Know exactly how your links are performing.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                </div>
                <h3>Clean Links</h3>
                <p>Replace cluttered URLs with short, memorable links that look professional everywhere.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 2L4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z"/><path d="M9 12l2 2 4-4"/></svg>
                </div>
                <h3>Secure Dashboard</h3>
                <p>Your account keeps every link private and organized — accessible only to you, anywhere you log in.</p>
            </div>
        </div>
    </section>

    <div class="divider"></div>

    <!-- ── How to Use Section ── -->
    <section class="how-section" id="how-to-use">
        <div class="section-label">How it works</div>
        <div class="steps-list">
            <div class="step">
                <div class="step-num">01</div>
                <div class="step-content">
                    <h4>Paste your URL</h4>
                    <p>Copy any long URL — from a blog post, product page, social profile, or document — and paste it into the input field above.</p>
                </div>
            </div>
            <div class="step">
                <div class="step-num">02</div>
                <div class="step-content">
                    <h4>Click "Shorten"</h4>
                    <p>Hit the Shorten button and aaxely instantly generates a compact, unique short link for you.</p>
                </div>
            </div>
            <div class="step">
                <div class="step-num">03</div>
                <div class="step-content">
                    <h4>Copy &amp; share</h4>
                    <p>Use the copy button to grab your new link and share it anywhere — messages, emails, social posts, or presentations.</p>
                </div>
            </div>
            <div class="step">
                <div class="step-num">04</div>
                <div class="step-content">
                    <h4>Watch your clicks grow</h4>
                    <p>Return to this page anytime to see how many people have clicked your links via the stats shown below.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="divider"></div>

    <!-- ── Links List ── -->
    <section class="links-section">
        <div class="links-section-header">
            <div class="section-label" style="margin-bottom:0">Your Links</div>
            <% if (locals.data) { %>
            <span class="links-count"><%= locals.data.length %> link<%= locals.data.length !== 1 ? 's' : '' %></span>
            <% } %>
        </div>

        <% if (locals.data) { %>
        <div class="links-list">
            <% locals.data.forEach(doc => { %>
            <div class="link-item">
                <span class="link-original" title="<%= doc.originalUrl %>"><%= doc.originalUrl %></span>
                <a class="link-short" href="http://localhost:8000/url/<%= doc.shortId %>">/<%= doc.shortId %></a>
                <span class="link-clicks">
                    <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    <%= doc.totalClicks %> click<%= doc.totalClicks !== 1 ? 's' : '' %>
                </span>
                <button class="delete-btn" type="button" data-short-id="<%= doc.shortId %>" aria-label="Delete link">
                    <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>
                </button>
            </div>
            <% }) %>
        </div>
        <% } %>

        <% if (!locals.data) { %>
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </div>
            <strong>No links yet</strong>
            <p>Paste a URL above to generate your first short link.</p>
        </div>
        <% } %>
    </section>

    <!-- ── Footer ── -->
    <footer>
        <div class="footer-brand">
            <span class="logo-text">aaxely</span>
            <p>A fast, minimal URL shortener built for people who value clean links and simple analytics.</p>
        </div>
        <div class="footer-links">
            <a href="/">Home</a>
            <a href="#how-to-use">How it works</a>
            <a href="#features">Features</a>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 aaxely. All rights reserved.</p>
            <p>Made with <span>♥</span> for the web</p>
        </div>
    </footer>

</div>

<script>
    function copyLink(btn, url) {
        navigator.clipboard.writeText(url).then(() => {
            btn.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
                btn.textContent = 'Copy';
                btn.classList.remove('copied');
            }, 2000);
        });
    }
</script>
</body>
</html>